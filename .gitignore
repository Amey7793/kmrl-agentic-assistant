*.egg-info/

# Source PDFs - 363MB total, one file (KMRL_AR_2015-16_EN.pdf, 144MB) exceeds
# GitHub's 100MB/file limit outright. Only needed to rebuild the KB index from
# scratch via index_documents.py - not needed to run the app.
Knowledge Base/PDFs/

# Unused legacy artifact - not referenced anywhere in the codebase
kmrl_agent/kb_index.pkl

# Generated artifacts that entrypoint.sh rebuilds automatically on container
# start from files that ARE committed (OpenData/, Lost and Found.json, Images/) -
# no need to track the output.
kmrl_agent/gtfs.db
kmrl_agent/lost_found.db
kmrl_agent/processed_images.json

# NOTE: kmrl_agent/chroma_db/ and kmrl_agent/bm25_index.pkl are NOT ignored -
# they can only be rebuilt from Knowledge Base/PDFs/, which is never committed
# (363MB, one file over GitHub's 100MB limit). Without these committed, kb_search
# permanently loses Annual Report / policy retrieval for anyone who clones fresh.

# Streamlit
.streamlit/

